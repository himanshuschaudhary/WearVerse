# ==============================================================
# WearVerse Frontend Environment Configuration
# ==============================================================

# Backend API Base URL (leave blank for standalone client mode or http://localhost:5000)
VITE_API_BASE_URL=http://localhost:5000

# Feature flags: 'true' uses backend API; 'false' runs in ultra-fast standalone mode
VITE_USE_REAL_AI=true
VITE_USE_REAL_TRYON=true

# Public Payment Gateway Keys (Client-side)
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyHere
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YourKeyHere
