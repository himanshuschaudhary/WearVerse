# ==============================================================================
# WearVerse Production Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the root directory (and `frontend/.env` / `backend/.env`)
# and fill in the values below.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (Exposed to browser via Vite - prefix with VITE_)
# ------------------------------------------------------------------------------

# Backend API Base URL (Leave blank or set to http://localhost:5000 in local dev)
VITE_API_BASE_URL=http://localhost:5000

# AI Generation Engine Flag:
# 'false' = Ultra-fast, zero-cost high-resolution neural mockup simulation (Free mode)
# 'true'  = Sends prompts directly to backend AI GPU endpoints (Fal.ai, Replicate, Gemini)
VITE_USE_REAL_AI=false

# Virtual Try-On Engine Flag:
# 'false' = Instant photorealistic 240 GSM heavy cotton drape simulation
# 'true'  = Sends photos to backend neural try-on pipeline (IDM-VTON / Fashn.ai)
VITE_USE_REAL_TRYON=false

# Payment Gateway (Public Client Keys):
# Razorpay Key ID for UPI (GPay, PhonePe, Paytm), RuPay & Cards in India
# Get your free test key from: https://dashboard.razorpay.com -> Settings -> API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyHere

# Stripe Publishable Key (for international USD / EUR checkout)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YourStripeKeyHere

# ------------------------------------------------------------------------------
# 2. BACKEND SECRETS (Server-side ONLY — Never share or commit to GitHub!)
# ------------------------------------------------------------------------------

# Port for Node backend server
PORT=5000

# A. Generative AI Image Provider Keys (Pick one for physical graphic synthesis):
# Option 1: Fal.ai Flux/SDXL (Fastest & highest streetwear quality - https://fal.ai)
FAL_KEY=

# Option 2: Replicate API Token (Flux / SDXL - https://replicate.com)
REPLICATE_API_TOKEN=

# Option 3: Google Gemini API (Get free tier key from https://aistudio.google.com)
GEMINI_API_KEY=

# Option 4: OpenAI DALL-E 3 (https://platform.openai.com)
OPENAI_API_KEY=

# B. Virtual Try-On Provider (Optional for live neural fitting):
# Fashn.ai API Key (https://fashn.ai)
FASHN_API_KEY=

# C. Razorpay Secret Key (For server-side payment verification & webhooks):
RAZORPAY_KEY_SECRET=

# D. Real-Time Order Notifications:
# Resend API Key for instant transactional email on new orders (https://resend.com)
RESEND_API_KEY=
OWNER_EMAIL=himanshu@wearverse.com

# WhatsApp Cloud API or Twilio (Optional for SMS / WhatsApp order alerts):
WHATSAPP_API_TOKEN=
OWNER_PHONE=+919876543210

# E. Database & Cloud Media Storage (Optional for production scaling):
# MongoDB Atlas Connection URI (Free cluster at https://mongodb.com/atlas)
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/wearverse?retryWrites=true&w=majority

# Cloudinary (For hosting user uploaded images and generated high-res assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# F. Print-on-Demand Fulfillment API (Printrove / Qikink / TeeShopper / Gelato):
PRINT_PARTNER_API_KEY=
